{
  "name": "asyncio",
  "version": "1.3.0",
  "builtin-baseline": "1846dc5db9d86e6dfda0246c5f7515d6e9c56d51",
  "dependencies": [
    "curl",
    "libuv",
    "nlohmann-json",
    "openssl",
    "treehh",
    "zero",
    "zlib"
  ],
  "default-features": [
    "tests"
  ],
  "features": {
    "c-ares": {
      "description": "Use c-ares for DNS resolution, enabling custom DNS server configuration",
      "dependencies": [
        "c-ares",
        {
          "name": "curl",
          "features": [
            "c-ares"
          ]
        }
      ]
    },
    "integration-samples": {
      "description": "Build integration samples",
      "dependencies": [
        "cpp-httplib",
        "grpc"
      ]
    },
    "tests": {
      "description": "Build tests",
      "dependencies": [
        "catch2"
      ]
    }
  }
}
